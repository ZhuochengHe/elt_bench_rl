# Execution image for ELT-Bench agent rollouts.
# The agent container joins the benchmark Compose network; PostgreSQL is
# reachable as elt-postgres:5432 from that network.
FROM python:3.11

RUN apt-get update && apt-get install -y \
    build-essential libpq-dev libssl-dev libffi-dev libxml2-dev libxslt1-dev \
    zlib1g-dev iputils-ping gnupg wget lsb-release ca-certificates curl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip
RUN pip install pyarrow db-dtypes pandas numpy plotly openpyxl

# Install dbt Core and the PostgreSQL and Snowflake adapters.
RUN pip install dbt-core dbt-postgres dbt-snowflake

# Database drivers and Airbyte client dependencies.
RUN pip install psycopg2-binary pymongo flask awscli requests

# Terraform is used by the agent to configure Airbyte.
RUN wget -O- https://apt.releases.hashicorp.com/gpg | \
      gpg --dearmor | tee /usr/share/keyrings/hashicorp-archive-keyring.gpg > /dev/null && \
    echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] \
      https://apt.releases.hashicorp.com $(lsb_release -cs) main" | \
      tee /etc/apt/sources.list.d/hashicorp.list && \
    apt-get update && apt-get install -y terraform && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Workspace mount point.
WORKDIR /workspace

CMD ["/bin/bash", "-c", "sleep infinity"]
